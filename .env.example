# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_complaints?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campus_complaints

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRE=7d

# CORS Allowed Client Origin
CLIENT_URL=http://localhost:5173

# Default Initial Administrator Configuration for 'npm run seed:admin'
ADMIN_NAME=Chief Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=CampusAdmin@2026
ADMIN_DEPT=Dean of Student Affairs & Campus Operations
